  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3d60f4b5",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-25T05:59:31.608186Z",
     "iopub.status.busy": "2026-08-25T05:59:31.608134Z",
     "iopub.status.idle": "2026-08-25T05:59:31.656135Z",
     "shell.execute_reply": "2026-08-25T05:59:31.655659Z"
